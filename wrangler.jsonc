{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crocodilemario",
  "compatibility_date": "2026-10-13",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/*"
    ]
  },
  "previews": {},
  "main": "src/server/worker.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "CONFIG",
        "class_name": "ConfigurationStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "config-v1",
      "new_sqlite_classes": [
        "ConfigurationStore"
      ]
    }
  ]
{
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
}
