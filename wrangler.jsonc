
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apollobrickgames",
  "compatibility_date": "2026-10-13",
  "keep_vars": true,
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFZb-NymWO_lZdka",
    "LEADERBOARD_ENV": "production"
  },
  "build": {
    "command": "npm run build"
  },
  "main": "src/server/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/*"
    ]
  },
  "previews": {},
  "durable_objects": {
    "bindings": [
      {
        "name": "CONFIG",
        "class_name": "ConfigurationStore"
      },
      {
        "name": "LEADERBOARDS",
        "class_name": "LeaderboardStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "config-v1",
      "new_sqlite_classes": [
        "ConfigurationStore"
      ]
    },
    {
      "tag": "leaderboards-v1",
      "new_sqlite_classes": [
        "LeaderboardStore"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "LEADERBOARD_WRITE_LIMIT",
      "namespace_id": "482901",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
