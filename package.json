{
  "name": "crocodile-mario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Браузерная коллекция складных Apollo и Brick Games: Mario, аркады и головоломки.",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base=/CrocodileMario/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "check:worker": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.1"
  }
}
